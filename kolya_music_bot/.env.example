# Единственное обязательное поле — токен от @BotFather
BOT_TOKEN=123456:replace-me

# Остальное бот заполнит сам командой /setup внутри группы
# (или можно прописать вручную)
# MUSIC_GROUP_ID=-1001234567890
# TOPIC_INBOX=1
# TOPIC_HIPHOP=2
# TOPIC_HOUSE=3
# TOPIC_TECHNO=4
# TOPIC_DISCO=5
# TOPIC_OTHER=6

CLASSIFY_THRESHOLD=0.55

# Опционально: свои каналы-источники (whitelist)
# SOURCE_CHANNEL_IDS=-100111,-100222
SOURCE_CHANNEL_IDS=
