# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-me

# Closed invite-only forum group (negative id, e.g. -100...)
MUSIC_GROUP_ID=-1001234567890

# Topic thread ids inside the forum group (create topics, then paste ids)
TOPIC_INBOX=1
TOPIC_HIPHOP=2
TOPIC_HOUSE=3
TOPIC_TECHNO=4
TOPIC_DISCO=5
TOPIC_OTHER=6

# Confidence below this → Inbox + ask
CLASSIFY_THRESHOLD=0.55

# Optional: comma-separated channel ids the bot may index (whitelist only)
# SOURCE_CHANNEL_IDS=-100111,-100222
SOURCE_CHANNEL_IDS=
