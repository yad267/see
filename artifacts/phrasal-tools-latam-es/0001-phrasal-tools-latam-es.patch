+                                        .font(.caption)
+                                        .foregroundStyle(.secondary)
+                                }
+                                Spacer(minLength: 0)
+                            }
+                        }
+                        .buttonStyle(.plain)
+                    }
+                    if !sections.isEmpty {
+                        HStack {
+                            Button("Все") {
+                                selectedSectionIds = Set(sections.map(\.id))
+                            }
+                            Button("Сброс") { selectedSectionIds = [] }
+                        }
+                        .font(.subheadline.weight(.semibold))
+                    }
+                }
+            }
+
+            if !selectedItems.isEmpty {
+                Section("Выбрано · \(selectedItems.count)") {
