<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: always-on Languages-on-site worker on Kolya Mac. Install via install-languages-on-site-worker.sh -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yad267.languages-on-site.worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPLACE_SCRIPT</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPLACE_WORKER_DIR</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>REPLACE_HOME/Library/Logs/languages-on-site/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_HOME/Library/Logs/languages-on-site/launchd.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CURSOR_MACHINE_NAME_LOS</key>
		<string>Languages-on-site</string>
		<key>LOS_WORKER_DIR</key>
		<string>REPLACE_WORKER_DIR</string>
		<key>PATH</key>
		<string>REPLACE_HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
