{
  "protocol_version": 2,
  "product": "English On Site",
  "domain_default": "construction_ireland",
  "principles": [
    "meaning_first",
    "pushed_output",
    "i_plus_1",
    "graduated_cf",
    "one_focus_form",
    "immediate_in_task_cf",
    "protect_wtc",
    "spaced_return",
    "variable_context",
    "goal_and_self_check",
    "scenario_immersion",
    "predictive_review"
  ],
  "repair_ladder": [
    { "level": 1, "move": "clarification" },
    { "level": 2, "move": "recast" },
    { "level": 3, "move": "metalinguistic_nudge" },
    { "level": 4, "move": "model_plus_reproduction" },
    { "level": 5, "move": "l1_gloss_plus_model" }
  ],
  "phases": [
    "open",
    "warm_retrieval",
    "task_run",
    "repair",
    "focus_flash",
    "close",
    "persist"
  ],
  "thresholds": {
    "roleplay_stt_f1": 0.75,
    "tutor_reproduction_f1": 0.7
  },
  "predictive_review": {
    "half_life_hours": 36,
    "frequency_weight": 0.35,
    "fail_weight": 0.45,
    "decay_weight": 0.55,
    "max_warm_items": 2,
    "success_intervals_days": [1, 3, 7, 21, 45]
  },
  "session_default_minutes": 10,
  "speak_max_sentences": 3,
  "l1": "ru",
  "default_cefr": "A2",
  "default_ilr_lite": "1",
  "scenario_pack": "scenarios/irish_site_v1.json",
  "sample_can_dos": [
    {
      "id": "gate-safe-pass",
      "cefr": "A2",
      "ilr_lite": "1",
      "can_do": "Sign in at the gate and say I have my Safe Pass",
      "task_brief": "You are the gate security officer on an Irish site.",
      "focus_form": "have_got"
    },
    {
      "id": "foreman-put-phrasals",
      "cefr": "A2",
      "ilr_lite": "1+",
      "can_do": "Follow and repeat put-up / put-back orders on site",
      "task_brief": "You are the foreman. Give short put-phrasal orders.",
      "focus_form": "phrasal_put"
    },
    {
      "id": "cabin-briefing",
      "cefr": "B1",
      "ilr_lite": "1+",
      "can_do": "Tell the foreman what I finished and what is blocked",
      "task_brief": "You are the foreman in the site cabin.",
      "focus_form": "present_perfect"
    }
  ]
}
