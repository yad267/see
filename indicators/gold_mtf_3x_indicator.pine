//@version=5
indicator("Gold MTF 3X", overlay=true, max_labels_count=500, max_lines_count=200)

// =============================================================================
// XAUUSD multi-TF: 4H bias → 1H levels → 15M pullback → 5M confirm (BOS/CHOCH/ENGULF/DTap)
// Рекомендуемый ТФ графика: 5 минут
// =============================================================================

grpT = "Timeframes"
tfBias  = input.timeframe("240", "Bias TF (4H)", group=grpT)
tfLevel = input.timeframe("60", "Levels TF (1H)", group=grpT)
tfPull  = input.timeframe("15", "Pullback TF (15M)", group=grpT)

grpS = "Signals"
pivotLen   = input.int(3, "Pivot left/right", minval=2, maxval=10, group=grpS)
edgeATR    = input.float(0.6, "Near level (×ATR)", minval=0.2, maxval=2.0, step=0.1, group=grpS)
useBos     = input.bool(true, "BOS", group=grpS)
useChoch   = input.bool(true, "CHOCH", group=grpS)
useEngulf  = input.bool(true, "ENGULF", group=grpS)
useDTap    = input.bool(true, "DOUBLE TAP", group=grpS)
showLevels = input.bool(true, "Draw 1H levels", group=grpS)
showWeak   = input.bool(false, "Show bias/pullback hints", group=grpS)

grpB = "Score"
lookforward = input.int(24, "Bars to score WIN/LOSS (on chart TF)", minval=5, maxval=200, group=grpB)
showScore   = input.bool(true, "Show WIN/LOSS", group=grpB)
showTable   = input.bool(true, "Stats table", group=grpB)

atr = ta.atr(14)

// --- 4H bias ---
ema20_4 = request.security(syminfo.tickerid, tfBias, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
ema50_4 = request.security(syminfo.tickerid, tfBias, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
bullBias = ema20_4 > ema50_4 and close > ema50_4
bearBias = ema20_4 < ema50_4 and close < ema50_4
flatBias = not bullBias and not bearBias

bgcolor(bullBias ? color.new(color.green, 94) : bearBias ? color.new(color.red, 94) : color.new(color.gray, 94))

// --- 1H pivots as levels ---
ph1 = request.security(syminfo.tickerid, tfLevel, ta.pivothigh(high, pivotLen, pivotLen), barmerge.gaps_off, barmerge.lookahead_off)
pl1 = request.security(syminfo.tickerid, tfLevel, ta.pivotlow(low, pivotLen, pivotLen), barmerge.gaps_off, barmerge.lookahead_off)

var float resLevel = na
var float supLevel = na
var line resLine = na
var line supLine = na

if not na(ph1)
    resLevel := ph1
    if showLevels
        if not na(resLine)
            line.set_x2(resLine, bar_index)
            line.set_extend(resLine, extend.none)
        resLine := line.new(bar_index - pivotLen, resLevel, bar_index, resLevel, color=color.new(color.red, 20), width=2, extend=extend.right)

if not na(pl1)
    supLevel := pl1
    if showLevels
        if not na(supLine)
            line.set_x2(supLine, bar_index)
            line.set_extend(supLine, extend.none)
        supLine := line.new(bar_index - pivotLen, supLevel, bar_index, supLevel, color=color.new(color.green, 20), width=2, extend=extend.right)

nearRes = not na(resLevel) and math.abs(close - resLevel) <= atr * edgeATR
nearSup = not na(supLevel) and math.abs(close - supLevel) <= atr * edgeATR

// --- 15M pullback context: require proximity on pull TF close ---
pullClose = request.security(syminfo.tickerid, tfPull, close, barmerge.gaps_off, barmerge.lookahead_off)
pullAtr   = request.security(syminfo.tickerid, tfPull, ta.atr(14), barmerge.gaps_off, barmerge.lookahead_off)
nearRes15 = not na(resLevel) and math.abs(pullClose - resLevel) <= pullAtr * edgeATR
nearSup15 = not na(supLevel) and math.abs(pullClose - supLevel) <= pullAtr * edgeATR
pullBuyZone  = nearSup or nearSup15
pullSellZone = nearRes or nearRes15

if showWeak and barstate.isconfirmed
    if bullBias and pullBuyZone
        label.new(bar_index, low, "15M zone", style=label.style_label_up, color=color.new(color.teal, 70), textcolor=color.white, size=size.tiny)
    if bearBias and pullSellZone
        label.new(bar_index, high, "15M zone", style=label.style_label_down, color=color.new(color.orange, 70), textcolor=color.white, size=size.tiny)

// --- 5M structure (chart TF) ---
pH = ta.pivothigh(high, pivotLen, pivotLen)
pL = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow  = na
var int   trendStruct   = 0  // 1 bullish structure, -1 bearish

if not na(pH)
    lastSwingHigh := pH
if not na(pL)
    lastSwingLow := pL

bosUp   = useBos and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bosDn   = useBos and not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow
chochUp = useChoch and trendStruct <= 0 and bosUp
chochDn = useChoch and trendStruct >= 0 and bosDn

if bosUp
    trendStruct := 1
if bosDn
    trendStruct := -1

bullEng = useEngulf and close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = useEngulf and close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// double tap: two touches of level within 8 bars, second with rejection
var int tapSupBars = 0
var int tapResBars = 0
var int lastTapSup = na
var int lastTapRes = na
tapSupNow = not na(supLevel) and low <= supLevel + atr * 0.15 and close > open
tapResNow = not na(resLevel) and high >= resLevel - atr * 0.15 and close < open
dTapUp = false
dTapDn = false
if useDTap and tapSupNow
    if not na(lastTapSup) and bar_index - lastTapSup <= 8 and bar_index - lastTapSup >= 2
        dTapUp := true
    lastTapSup := bar_index
if useDTap and tapResNow
    if not na(lastTapRes) and bar_index - lastTapRes <= 8 and bar_index - lastTapRes >= 2
        dTapDn := true
    lastTapRes := bar_index

confirmUp = bosUp or chochUp or bullEng or dTapUp
confirmDn = bosDn or chochDn or bearEng or dTapDn

f_tag() =>
    t = ""
    if bosUp or bosDn
        t += "BOS"
    if chochUp or chochDn
        t += (t == "" ? "" : "+") + "CHOCH"
    if bullEng or bearEng
        t += (t == "" ? "" : "+") + "ENG"
    if dTapUp or dTapDn
        t += (t == "" ? "" : "+") + "DTAP"
    t

var int lastSetupBar = na
var int lastSetupDir = 0
cooldown = 10

setupUp = bullBias and pullBuyZone and confirmUp and (na(lastSetupBar) or bar_index - lastSetupBar >= cooldown)
setupDn = bearBias and pullSellZone and confirmDn and (na(lastSetupBar) or bar_index - lastSetupBar >= cooldown)

var array<int>   sigBar  = array.new_int()
var array<float> sigPx   = array.new_float()
var array<int>   sigDir  = array.new_int()
var array<bool>  sigDone = array.new_bool()
var int nSetup = 0
var int wSetup = 0
var int lSetup = 0

if barstate.isconfirmed and setupUp
    lastSetupBar := bar_index
    lastSetupDir := 1
    nSetup += 1
    label.new(bar_index, low, "↑ SETUP " + f_tag(), style=label.style_label_up, color=color.new(color.yellow, 5), textcolor=color.black, size=size.small)
    array.push(sigBar, bar_index)
    array.push(sigPx, close)
    array.push(sigDir, 1)
    array.push(sigDone, false)

if barstate.isconfirmed and setupDn
    lastSetupBar := bar_index
    lastSetupDir := -1
    nSetup += 1
    label.new(bar_index, high, "↓ SETUP " + f_tag(), style=label.style_label_down, color=color.new(color.yellow, 5), textcolor=color.black, size=size.small)
    array.push(sigBar, bar_index)
    array.push(sigPx, close)
    array.push(sigDir, -1)
    array.push(sigDone, false)

if showScore and array.size(sigBar) > 0
    for i = 0 to array.size(sigBar) - 1
        if not array.get(sigDone, i) and bar_index == array.get(sigBar, i) + lookforward
            dir = array.get(sigDir, i)
            px  = array.get(sigPx, i)
            win = dir > 0 ? close > px : close < px
            array.set(sigDone, i, true)
            if win
                wSetup += 1
            else
                lSetup += 1
            label.new(bar_index, dir > 0 ? high : low, win ? "WIN" : "LOSS", style=dir > 0 ? label.style_label_down : label.style_label_up, color=win ? color.new(color.teal, 20) : color.new(color.orange, 20), textcolor=color.white, size=size.tiny)

f_pct(w, l) =>
    t = w + l
    t == 0 ? "n/a" : str.tostring(100.0 * w / t, "#.#") + "%"

var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)
if showTable and barstate.islast
    biasTxt = bullBias ? "BUY only" : bearBias ? "SELL only" : "FLAT — no trade"
    table.cell(t, 0, 0, "Gold MTF 3X", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "chart 5m", text_color=color.gray, text_size=size.small)
    table.cell(t, 0, 1, "4H bias", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, biasTxt, text_color=bullBias ? color.lime : bearBias ? color.red : color.gray, text_size=size.small)
    table.cell(t, 0, 2, "SETUPs", text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(nSetup), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Winrate", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, f_pct(wSetup, lSetup), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "Sup / Res", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, (na(supLevel) ? "-" : str.tostring(supLevel, "#.##")) + " / " + (na(resLevel) ? "-" : str.tostring(resLevel, "#.##")), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 5, "Rule", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, "4H→1H zone→5M confirm", text_color=color.gray, text_size=size.tiny)
