//@version=5
indicator("Session Pattern Strategy", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// === СЕССИЯ ===
grpS = "Session"
sessionTime  = input.session("0000-0800", "Session Time", group=grpS)
sessionTz    = input.string("UTC", "Timezone", options=["UTC", "Exchange", "Europe/Dublin", "Europe/London", "America/New_York"], group=grpS)
keepSessions = input.int(30, "Keep last N ranges", minval=1, maxval=150, group=grpS)
minRange     = input.float(0.0, "Min range (price, 0=off)", minval=0, group=grpS)

// === ПАТТЕРНЫ ===
grpP = "Patterns"
showBreak  = input.bool(true, "BREAK", group=grpP)
showFake   = input.bool(true, "FAKE (false break)", group=grpP)
showRetest = input.bool(true, "RETEST", group=grpP)
showPin    = input.bool(true, "PIN bar", group=grpP)
showEngulf = input.bool(true, "ENGULF", group=grpP)
fakeBars   = input.int(8, "FAKE: bars to return inside", minval=1, maxval=50, group=grpP)
retestBars = input.int(30, "RETEST: max bars after break", minval=3, maxval=100, group=grpP)
edgeATR    = input.float(0.35, "PIN/ENGULF: max distance to edge (×ATR)", minval=0.1, maxval=2.0, step=0.05, group=grpP)
pinWickMul = input.float(2.0, "PIN: wick ≥ body ×", minval=1.2, maxval=5.0, step=0.1, group=grpP)

// === БЭКТЕСТ МЕТКИ ===
grpB = "Scoring"
lookforward = input.int(20, "Bars to score WIN/LOSS", minval=1, maxval=200, group=grpB)
showScore   = input.bool(true, "Show WIN/LOSS", group=grpB)
showTable   = input.bool(true, "Stats table", group=grpB)

tz = sessionTz == "Exchange" ? syminfo.timezone : sessionTz
atr = ta.atr(14)

// === СЕССИОННЫЙ RANGE ===
inSession    = not na(time(timeframe.period, sessionTime, tz))
sessionStart = inSession and not inSession[1]
sessionEnd   = not inSession and inSession[1]

var float curHigh = na
var float curLow  = na

if sessionStart
    curHigh := high
    curLow  := low
else if inSession
    curHigh := math.max(curHigh, high)
    curLow  := math.min(curLow, low)

bgcolor(inSession ? color.new(color.blue, 93) : na)

// Активный торговый range (последняя завершённая сессия)
var float lvlHigh = na
var float lvlLow  = na
var int   rangeEndBar = na
var bool  upBroken = false
var bool  dnBroken = false
var int   upBreakBar = na
var int   dnBreakBar = na
var bool  upFaked = false
var bool  dnFaked = false
var bool  upRetestDone = false
var bool  dnRetestDone = false
var bool  upPinDone = false
var bool  dnPinDone = false
var bool  upEngDone = false
var bool  dnEngDone = false
var line  hLine = na
var line  lLine = na

f_newLabel(x, y, txt, col, up) =>
    label.new(x, y, txt, style=up ? label.style_label_up : label.style_label_down, color=col, textcolor=color.white, size=size.small)

// Очередь сигналов для скоринга
var array<int>    sigBar  = array.new_int()
var array<float>  sigPx   = array.new_float()
var array<int>    sigDir  = array.new_int()
var array<string> sigType = array.new_string()
var array<bool>   sigDone = array.new_bool()

var int nBreak=0
var int nFake=0
var int nRetest=0
var int nPin=0
var int nEngulf=0
var int wBreak=0
var int lBreak=0
var int wFake=0
var int lFake=0
var int wRetest=0
var int lRetest=0
var int wPin=0
var int lPin=0
var int wEngulf=0
var int lEngulf=0

f_pushSig(dir, typ, px) =>
    array.push(sigBar, bar_index)
    array.push(sigPx, px)
    array.push(sigDir, dir)
    array.push(sigType, typ)
    array.push(sigDone, false)

// Новая сессия завершилась → новый range
if sessionEnd and not na(curHigh) and not na(curLow)
    rng = curHigh - curLow
    if minRange <= 0 or rng >= minRange
        if not na(hLine)
            line.set_extend(hLine, extend.none)
            line.set_x2(hLine, bar_index)
        if not na(lLine)
            line.set_extend(lLine, extend.none)
            line.set_x2(lLine, bar_index)
        lvlHigh := curHigh
        lvlLow  := curLow
        rangeEndBar := bar_index
        upBroken := false
        dnBroken := false
        upBreakBar := na
        dnBreakBar := na
        upFaked := false
        dnFaked := false
        upRetestDone := false
        dnRetestDone := false
        upPinDone := false
        dnPinDone := false
        upEngDone := false
        dnEngDone := false
        hLine := line.new(bar_index - 1, lvlHigh, bar_index, lvlHigh, color=color.green, width=2, extend=extend.right)
        lLine := line.new(bar_index - 1, lvlLow, bar_index, lvlLow, color=color.red, width=2, extend=extend.right)

nearHigh = not na(lvlHigh) and math.abs(close - lvlHigh) <= atr * edgeATR
nearLow  = not na(lvlLow)  and math.abs(close - lvlLow)  <= atr * edgeATR
body     = math.abs(close - open)
upperW   = high - math.max(open, close)
lowerW   = math.min(open, close) - low
bullPin  = body > 0 and lowerW >= body * pinWickMul and upperW <= body * 0.8 and close > open
bearPin  = body > 0 and upperW >= body * pinWickMul and lowerW <= body * 0.8 and close < open
bullEng  = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng  = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

postSession = not inSession and not na(lvlHigh) and not na(lvlLow)

if postSession
    // --- BREAK ---
    if not upBroken and close > lvlHigh
        upBroken := true
        upBreakBar := bar_index
        nBreak += 1
        if showBreak
            f_newLabel(bar_index, lvlHigh, "↑ BREAK", color.new(color.green, 15), false)
            f_pushSig(1, "BREAK", close)
        if not na(hLine)
            line.set_x2(hLine, bar_index)
            line.set_extend(hLine, extend.none)

    if not dnBroken and close < lvlLow
        dnBroken := true
        dnBreakBar := bar_index
        nBreak += 1
        if showBreak
            f_newLabel(bar_index, lvlLow, "↓ BREAK", color.new(color.red, 15), true)
            f_pushSig(-1, "BREAK", close)
        if not na(lLine)
            line.set_x2(lLine, bar_index)
            line.set_extend(lLine, extend.none)

    // --- FAKE ---
    if showFake and upBroken and not upFaked and not na(upBreakBar) and bar_index > upBreakBar and bar_index <= upBreakBar + fakeBars
        if close < lvlHigh
            upFaked := true
            nFake += 1
            f_newLabel(bar_index, high, "↓ FAKE", color.new(color.orange, 10), false)
            f_pushSig(-1, "FAKE", close)

    if showFake and dnBroken and not dnFaked and not na(dnBreakBar) and bar_index > dnBreakBar and bar_index <= dnBreakBar + fakeBars
        if close > lvlLow
            dnFaked := true
            nFake += 1
            f_newLabel(bar_index, low, "↑ FAKE", color.new(color.aqua, 10), true)
            f_pushSig(1, "FAKE", close)

    // --- RETEST ---
    // После ап-пробоя (не фейк): касание уровня сверху и close снова выше
    if showRetest and upBroken and not upFaked and not upRetestDone and not na(upBreakBar) and bar_index > upBreakBar and bar_index <= upBreakBar + retestBars
        touched = low <= lvlHigh and close > lvlHigh
        reject  = bullPin or bullEng or (close > open and low <= lvlHigh)
        if touched and reject
            upRetestDone := true
            nRetest += 1
            f_newLabel(bar_index, low, "↑ RETEST", color.new(color.teal, 10), true)
            f_pushSig(1, "RETEST", close)

    if showRetest and dnBroken and not dnFaked and not dnRetestDone and not na(dnBreakBar) and bar_index > dnBreakBar and bar_index <= dnBreakBar + retestBars
        touched = high >= lvlLow and close < lvlLow
        reject  = bearPin or bearEng or (close < open and high >= lvlLow)
        if touched and reject
            dnRetestDone := true
            nRetest += 1
            f_newLabel(bar_index, high, "↓ RETEST", color.new(color.fuchsia, 10), false)
            f_pushSig(-1, "RETEST", close)

    // --- PIN у границы (1 раз на сторону range) ---
    if showPin
        if not upPinDone and nearLow and bullPin
            upPinDone := true
            nPin += 1
            f_newLabel(bar_index, low, "↑ PIN", color.new(color.lime, 25), true)
            f_pushSig(1, "PIN", close)
        if not dnPinDone and nearHigh and bearPin
            dnPinDone := true
            nPin += 1
            f_newLabel(bar_index, high, "↓ PIN", color.new(color.maroon, 25), false)
            f_pushSig(-1, "PIN", close)

    // --- ENGULF у границы (1 раз на сторону range) ---
    if showEngulf
        if not upEngDone and nearLow and bullEng
            upEngDone := true
            nEngulf += 1
            f_newLabel(bar_index, low, "↑ ENGULF", color.new(color.green, 35), true)
            f_pushSig(1, "ENGULF", close)
        if not dnEngDone and nearHigh and bearEng
            dnEngDone := true
            nEngulf += 1
            f_newLabel(bar_index, high, "↓ ENGULF", color.new(color.red, 35), false)
            f_pushSig(-1, "ENGULF", close)

// Скоринг через N баров
if showScore and array.size(sigBar) > 0
    for i = 0 to array.size(sigBar) - 1
        if not array.get(sigDone, i)
            b = array.get(sigBar, i)
            if bar_index == b + lookforward
                dir = array.get(sigDir, i)
                px  = array.get(sigPx, i)
                typ = array.get(sigType, i)
                win = dir > 0 ? close > px : close < px
                array.set(sigDone, i, true)
                if typ == "BREAK"
                    if win
                        wBreak += 1
                    else
                        lBreak += 1
                else if typ == "FAKE"
                    if win
                        wFake += 1
                    else
                        lFake += 1
                else if typ == "RETEST"
                    if win
                        wRetest += 1
                    else
                        lRetest += 1
                else if typ == "PIN"
                    if win
                        wPin += 1
                    else
                        lPin += 1
                else if typ == "ENGULF"
                    if win
                        wEngulf += 1
                    else
                        lEngulf += 1
                label.new(bar_index, dir > 0 ? high : low, win ? (dir > 0 ? "↑ WIN" : "↓ WIN") : (dir > 0 ? "↑ LOSS" : "↓ LOSS"), style=dir > 0 ? label.style_label_down : label.style_label_up, color=win ? color.new(color.teal, 20) : color.new(color.orange, 20), textcolor=color.white, size=size.tiny)

f_pct(w, l) =>
    t = w + l
    t == 0 ? "n/a" : str.tostring(100.0 * w / t, "#.#") + "%"

var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 72), border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "Pattern Strategy", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, sessionTime + " " + tz, text_color=color.gray, text_size=size.small)
    table.cell(t, 0, 1, "BREAK", text_color=color.green, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(nBreak) + " | " + f_pct(wBreak, lBreak), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "FAKE", text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(nFake) + " | " + f_pct(wFake, lFake), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "RETEST", text_color=color.teal, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(nRetest) + " | " + f_pct(wRetest, lRetest), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "PIN", text_color=color.lime, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(nPin) + " | " + f_pct(wPin, lPin), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "ENGULF", text_color=color.fuchsia, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(nEngulf) + " | " + f_pct(wEngulf, lEngulf), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 6, "Lookforward", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(lookforward) + " bars", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 7, "TF tip", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 7, "use M15", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 8, "Priority", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8, "FAKE > RETEST > BREAK > PIN/ENGULF", text_color=color.gray, text_size=size.tiny)
